# =============================================================================
# Stock Market Dashboard - client environment
# =============================================================================
# Every variable here is OPTIONAL. Each has a default in code
# (`src/lib/env.ts` and `vite.config.ts`), so the app builds and runs with no
# `client/.env` at all. Copy this file only if you need to override something.
#
# SECURITY: anything prefixed VITE_ is inlined into the JavaScript bundle and
# is therefore PUBLIC. Never put a secret, API key or password in this file -
# the server holds those. See `server/.env.example`.
# =============================================================================

# Where the browser sends API calls. Relative by default, which is what keeps
# the SPA and API same-origin: Vite proxies it in development and the
# vercel.json rewrite handles it in production. That same-origin setup is why
# the refresh cookie can stay SameSite=Lax instead of a third-party cookie
# that Safari and Brave would drop.
# Only set an absolute URL if you deliberately stop proxying.
# VITE_API_BASE_URL=/api/v1

# Product name shown in the UI.
# VITE_APP_NAME=Stock Market Dashboard

# Dev server only, and NOT prefixed VITE_ on purpose - it must never reach the
# bundle. Where `npm run dev` proxies /api to your local backend.
# DEV_API_PROXY_TARGET=http://127.0.0.1:5000
