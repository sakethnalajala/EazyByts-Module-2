# =============================================================================
# Stock Market Dashboard - server environment
# =============================================================================
# Copy to `server/.env` and fill in. This file is the ONLY .env variant that is
# committed, and it must never contain a real secret.
#
# Every variable below is read through the zod schema in
# `src/config/env.ts`. Nothing else in the codebase touches process.env, so
# this list is complete by construction.
#
# Variables marked OPTIONAL can be left unset: each has a working fallback.
# Leave them unset rather than blank - a blank value makes the code try to use
# the integration and fail, where an absent one cleanly selects the fallback.
# =============================================================================

# ------------------------------------------------------------------- runtime
NODE_ENV=development
# Render injects PORT and expects the process to bind to it. Do NOT set it there.
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# Number of proxy hops to trust for client IPs. Render terminates TLS at one
# proxy, so 1 there; 0 locally. Getting this wrong breaks per-IP rate limiting.
TRUST_PROXY=0

# ------------------------------------------------------------------ database
# Atlas: Connect > Drivers. URL-encode any special characters in the password.
# Leave the path empty - the app passes MONGODB_DB_NAME explicitly, so the
# path segment can never silently redirect you to the `test` database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=stock_market_dashboard

# ---------------------------------------------------------------------- cors
# Comma-separated. In production this is the deployed SPA origin.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------- auth
# REQUIRED IN PRODUCTION. The app ships development fallbacks and refuses to
# boot with NODE_ENV=production if it sees them, because anyone reading this
# repository could otherwise mint valid tokens.
# Generate two DIFFERENT values, 32+ chars each:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-string

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=smd_rt

# lax is correct while the SPA proxies /api, which keeps them same-origin.
# Switch to none ONLY if you stop proxying - and then APP_URL must be https,
# because browsers reject SameSite=None without Secure.
COOKIE_SAMESITE=lax
# OPTIONAL. Only when the API and SPA are on different subdomains.
# COOKIE_DOMAIN=.example.com

# Public URL of the SPA. Verification and password-reset links are built from
# this, so a wrong value produces emails that lead nowhere.
APP_URL=http://localhost:5173

# --------------------------------------------------------------------- email
# OPTIONAL. Unset, the mailer logs the message and the API returns the
# verification link in the response body, which keeps local development and a
# graded demo fully working without a mail provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=replace-with-smtp-password
SMTP_SECURE=false
MAIL_FROM=Stock Market Dashboard <no-reply@example.com>

# --------------------------------------------------------------- market data
# Yahoo is the primary provider and needs NO key. These optional keys enable
# the second and third tiers of the provider chain; without them the chain is
# Yahoo -> deterministic mock.
# FINNHUB_API_KEY=replace-with-finnhub-key
# ALPHAVANTAGE_API_KEY=replace-with-alphavantage-key

# Forces the deterministic simulator. Useful offline; never true in production.
MARKET_DATA_FORCE_MOCK=false
QUOTE_CACHE_TTL_SECONDS=30

# --------------------------------------------------------------------- cache
# OPTIONAL. Backs the quote cache, the refresh-token denylist and distributed
# rate limits. Each has an in-process fallback, so the app runs without it and
# /ready reports redis as "disabled" rather than "down". Set it in production
# if you run more than one instance - the in-process fallbacks are per-process.
# REDIS_URL=rediss://default:password@host:6379

# ------------------------------------------------------------------- workers
ENABLE_WORKERS=true
ORDER_MATCHER_INTERVAL_SECONDS=30
ALERT_EVALUATOR_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------- demo
# OPTIONAL global override for every demo account password.
#
# Leave it UNSET (the normal case) and each demo account uses its own
# password, defined next to the account in server/src/modules/auth/
# auth.service.ts and shown on the sign-in screen:
#
#   user.demo@stockdashboard.com        (User, view-only)
#   trader.demo@stockdashboard.com      (Trader)
#   admin.demo@stockdashboard.com       (Admin)
#   superadmin.demo@stockdashboard.com  (Super Admin)
#
# Set it to collapse all four onto one rotated value - useful if you expose
# the deployment publicly and want to take the documented ones out of play.
# DEMO_PASSWORD=
